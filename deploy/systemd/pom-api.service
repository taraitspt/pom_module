# POM 백엔드 — /etc/systemd/system/pom-api.service
# jar 는 /opt/pom/pom-module-api.jar, 환경변수는 /etc/pom/pom.env(권한 600, root 소유).
[Unit]
Description=TARA POM API (Spring Boot)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=pom
Group=pom
WorkingDirectory=/opt/pom
EnvironmentFile=/etc/pom/pom.env
# 서버 메모리 2GB(Lightsail) — MariaDB·nginx 와 같이 쓰므로 힙은 768MB. 서버를 키우면 같이 올린다.
# -Duser.language=ko -Duser.country=KR: Oracle JDBC 가 JVM 로케일로 세션 NLS(날짜 형식)를 정한다. 로컬(한국어 Windows)과 같게 두지 않으면
#   문자열↔DATE 암묵 변환이 운영에서만 깨진다(2026-10-15 매출리스트 ORA-01847).
ExecStart=/usr/bin/java -Xms256m -Xmx768m -XX:+UseSerialGC -Duser.timezone=Asia/Seoul -Duser.language=ko -Duser.country=KR -Dfile.encoding=UTF-8 \
  -jar /opt/pom/pom-module-api.jar --spring.profiles.active=prod --server.address=127.0.0.1
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# 로그는 journalctl -u pom-api -f

[Install]
WantedBy=multi-user.target
